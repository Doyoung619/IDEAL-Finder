# Vercel/public gateway. Never commit real values.
APP_ROLE=gateway
APP_ENV=production
GPU_BACKEND_URL=https://gpu.example.com
GPU_GATEWAY_SECRET=replace-with-the-same-long-random-secret-as-the-gpu-server

# Keep the upstream timeout bounded below the deployment platform request budget.
GPU_REQUEST_TIMEOUT_SECONDS=50
GPU_CONNECT_TIMEOUT_SECONDS=5
