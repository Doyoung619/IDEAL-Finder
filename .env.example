# Legacy monolith/GPU settings. Prefer .env.gpu.example for split deployment.
# Never commit real values.
APP_ROLE=gpu
APP_ENV=production
GPU_GATEWAY_SECRET="replace-with-a-long-random-secret"
SESSION_SECRET="replace-with-a-different-long-random-secret"
# IDEAL_SECRET_KEY remains a backward-compatible alias for SESSION_SECRET.
IDEAL_ADMIN_PASSWORD="replace-with-a-separate-admin-password"
IDEAL_DATABASE_URL="postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"
IDEAL_CONSENT_VERSION="replace-with-approved-protocol-version"
IDEAL_APP_VERSION="replace-with-git-commit-or-release"

# The research/GPU server must use DB-backed artifacts for restart recovery.
IDEAL_CONFIG="configs/persona_study.yaml"
IDEAL_ARTIFACT_STORAGE=database
IDEAL_SECURE_COOKIES=1

# Host-specific research artifacts. These override the checked-in research
# config paths without changing algorithm settings.
IDEAL_STYLEGAN_REPO="/srv/ideal-finder/stylegan3"
IDEAL_STYLEGAN_NETWORK="/srv/ideal-finder/checkpoints/stylegan3.pkl"
IDEAL_FAIRFACE_RACE_WEIGHTS="/srv/ideal-finder/checkpoints/fairface_race"
IDEAL_FAIRFACE_GENDER_WEIGHTS="/srv/ideal-finder/checkpoints/fairface_gender"
IDEAL_FAIRFACE_AGE_WEIGHTS="/srv/ideal-finder/checkpoints/fairface_age"
IDEAL_FACE_DETECTOR_PATH="/srv/ideal-finder/checkpoints/face_detection_yunet.onnx"
IDEAL_PRIOR_PATH="/srv/ideal-finder/artifacts/priors/{gender}_20_29_{race}_d12.npz"
IDEAL_PERSONA_FEMALE_POOL="/srv/ideal-finder/artifacts/persona_pools/female_20_29_east_asian_d12"
IDEAL_PERSONA_MALE_POOL="/srv/ideal-finder/artifacts/persona_pools/male_20_29_east_asian_d12"

# Optional local overrides.
# IDEAL_CONFIG=configs/default.yaml
# IDEAL_DATA_DIR=data
# IDEAL_CACHE_DIR=cache
# IDEAL_OUTPUT_DIR=outputs
# IDEAL_MODEL_DIR=models
# IDEAL_DEMO=1
# IDEAL_DB_POOL=serverless
