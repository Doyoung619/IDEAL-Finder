# Required for deployed/serverless environments.
IDEAL_SECRET_KEY="replace-with-a-long-random-secret"
IDEAL_ADMIN_PASSWORD="replace-with-a-separate-admin-password"
IDEAL_DATABASE_URL="postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# Vercel deployments default to demo mode and DB-backed generated artifacts.
# Keep these explicit if you want the deployment behavior to be obvious.
IDEAL_DEMO=1
IDEAL_ARTIFACT_STORAGE=database
IDEAL_DB_POOL=serverless

# Optional local overrides.
# IDEAL_CONFIG=configs/default.yaml
# IDEAL_DATA_DIR=data
# IDEAL_CACHE_DIR=cache
# IDEAL_OUTPUT_DIR=outputs
# IDEAL_MODEL_DIR=models
