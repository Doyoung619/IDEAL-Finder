# Research-lab GPU worker. Never commit real values.
APP_ROLE="gpu"
APP_ENV="production"
IDEAL_CONFIG="configs/persona_study.yaml"

# Shared securely with the gateway operator.
GPU_GATEWAY_SECRET="replace-with-a-long-random-secret"

# Used only by the GPU app to sign the opaque participant/session cookie.
SESSION_SECRET="replace-with-a-different-long-random-secret"
IDEAL_ADMIN_PASSWORD="replace-with-a-separate-admin-password"

# Any PostgreSQL provider is supported through its connection string.
IDEAL_DATABASE_URL="postgresql+psycopg://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"
IDEAL_ARTIFACT_STORAGE="database"
IDEAL_CONSENT_VERSION="replace-with-approved-protocol-version"
IDEAL_APP_VERSION="replace-with-git-commit-or-release"

# Host-specific model and research artifact paths.
IDEAL_STYLEGAN_REPO="/path/to/stylegan3"
IDEAL_STYLEGAN_NETWORK="/path/to/stylegan3-r-ffhqu-256x256.pkl"
IDEAL_PRIOR_PATH="/path/to/priors/{gender}_20_29_{race}_d12.npz"
IDEAL_PERSONA_FEMALE_POOL="/path/to/persona_pools/female_20_29_east_asian_d12"
IDEAL_PERSONA_MALE_POOL="/path/to/persona_pools/male_20_29_east_asian_d12"

# These are needed only when rebuilding/validating pools on this host.
IDEAL_FAIRFACE_RACE_WEIGHTS="/path/to/fairface_race"
IDEAL_FAIRFACE_GENDER_WEIGHTS="/path/to/fairface_gender"
IDEAL_FAIRFACE_AGE_WEIGHTS="/path/to/fairface_age"
IDEAL_FACE_DETECTOR_PATH="/path/to/face_detection_yunet.onnx"

IDEAL_HOST="0.0.0.0"
IDEAL_PORT="8000"
